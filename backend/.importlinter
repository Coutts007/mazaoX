[importlinter:contract:events-only-for-notifications-and-audit]
name = Business domains publish events instead of importing notifications/audit services
type = forbidden
source_modules =
    apps.administration
    apps.catalogue
    apps.delivery
    apps.demand
    apps.identity
    apps.inventory
    apps.issues
    apps.orders
    apps.payments
    apps.profiles
    apps.quality
    apps.reviews
forbidden_modules =
    apps.notifications.services
    apps.audit.services
allow_indirect_imports = True
ignore_imports =
    apps.**.tests.** -> apps.notifications.services
    apps.**.tests.** -> apps.audit.services

[importlinter:contract:core-is-independent-of-domains]
name = core does not depend on any domain app
type = forbidden
source_modules =
    core
forbidden_modules =
    apps
allow_indirect_imports = True
