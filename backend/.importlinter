# Import contracts (ADR-004). Run from this directory: `lint-imports` (also run by core/tests/test_import_contracts.py).
# The allow-list rule is also enforced by core/tests/test_boundaries.py; this file is the same policy in the standard tool.
# Cross-domain code may import only <domain>.services, <domain>.selectors, <domain>.contracts (and identity.permissions).

[importlinter]
root_packages =
    apps
    core
include_external_packages = False

[importlinter:contract:administration-internals-are-private]
name = administration: other domains may only use its services, selectors and contracts
type = forbidden
source_modules =
    apps.audit
    apps.catalogue
    apps.delivery
    apps.demand
    apps.identity
    apps.inventory
    apps.issues
    apps.notifications
    apps.orders
    apps.payments
    apps.profiles
    apps.quality
    apps.reviews
forbidden_modules =
    apps.administration.api
    apps.administration.management
    apps.administration.migrations
allow_indirect_imports = True

