# Copy to .env and replace placeholders. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5180
DB_NAME=mazaox
DB_USER=mazaox
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433

# SIMULATED payments: enables the demo-only completion endpoint. Never enable in a hosted environment.
PAYMENT_SIMULATION_ENABLED=true
# Optional: host port for the containerised API (default 8010)
# BACKEND_PORT=8010

# Redis (cache + shared rate limits). Leave REDIS_URL empty to use per-process memory.
# REDIS_URL=redis://localhost:6380/1
# REDIS_PORT=6380
# Hosted environments: DJANGO_DEBUG=false, a strong DJANGO_SECRET_KEY, SECURE_SSL=true, PAYMENT_SIMULATION_ENABLED=false
# SECURE_SSL=true
# API_DOCS_ENABLED=true
# PUBLIC_CACHE_ENABLED=true
# MEDIA_MAX_BYTES=5242880
